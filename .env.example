# LLM Provider
AI_PROVIDER=openrouter
# OpenRouter free router: rate limits and availability apply.
OPENROUTER_API_KEY=
# Optional legacy paid providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=openrouter/free

# Moltbook
MOLTBOOK_API_URL=https://www.moltbook.com
MOLTBOOK_SUBMOLT=lablab
MOLTBOOK_AUTH_TOKEN=
MOLTBOOK_AGENT_NAME=signalharbor

# SURGE / On-chain
SURGE_API_URL=https://api.surge.xyz
BASE_RPC_URL=https://sepolia.base.org
SOLANA_RPC_URL=https://api.devnet.solana.com
WALLET_PRIVATE_KEY=

# OpenClaw
OPENCLAW_GATEWAY=ws://127.0.0.1:18789

# Server
HOST=127.0.0.1
PORT=8899
SECRET_KEY=signalharbor-dev-key

# API access (separate from LLM provider credentials)
# Required for all HTTP access; blank denies access. Setup generates a key.
# Use a long random value.
API_KEY=

# SQLite: blank uses data/signalharbor.db
# Set an absolute path to override the default.
# DATABASE_PATH=/absolute/path/to/signalharbor.db

# Background scheduling is opt-in and may incur LLM charges.
# It never publishes reports or deploys tokens.
SCHEDULER_ENABLED=false
SCOUT_INTERVAL_MINUTES=60
